            <column caption='Online Delivery %' datatype='real' default-format='p0%' name='[Calculation_0656717153882112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Has Online delivery] = &quot;Yes&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([Restaurant ID])' />
