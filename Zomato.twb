            <shelf-sort-v2 dimension-to-sort='[federated.0xp2ew61n4e0dn1ez2fgf052mend].[none:Restaurant Name:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.0xp2ew61n4e0dn1ez2fgf052mend].[sum:Calculation_0656717196644354:qk]' shelf='rows' />
          </shelf-sorts>
